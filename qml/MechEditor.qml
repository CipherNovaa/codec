                                    color: sline.sel ? "#14121f" : "#e6eff5"
                                    font.family: ed.sysFont(sline.modelData.k)
                                    font.pixelSize: ed.fp(11)
                                }
                                Text {
                                    anchors.verticalCenter: parent.verticalCenter
                                    text: (ed.sys && sline.modelData.k) ? ed.fmt(ed.sys[sline.modelData.k]) : ""
                                    color: sline.sel ? "#14121f" : "#f2f8fc"
                                    font.family: Theme.monoFont; font.bold: true
                                    font.pixelSize: ed.fp(12); font.letterSpacing: 1
                                }
                            }
                        }
                    }
                    Item { width: 1; height: 4 * ed.px }
                    Text {
                        anchors.horizontalCenter: parent.horizontalCenter
                        width: parent.width - 8; horizontalAlignment: Text.AlignHCenter; wrapMode: Text.WordWrap
                        text: (ed.sysRows[ed.sysIdx] && ed.sysRows[ed.sysIdx].desc) ? ed.sysRows[ed.sysIdx].desc : "these style the GARAGE editor itself · saved separately"
                        color: Theme.withAlpha("#9fd8e6", 0.85)
                        font.family: Theme.monoFont; font.italic: true
                        font.pixelSize: ed.fp(10); font.letterSpacing: 1
                    }
                    }
                }

                // ── PAGE 4: DATA — garage state + controls (AC-stats style) ──
                Flickable {  // scrolls inside the same fixed frame as the other pages
                    id: dataFlick
                    visible: ed.page === "data"
                    width: parent.width
                    height: visible ? Math.min(dataCol.height, ed.view ? Math.round(ed.view.height * 0.6) : 430) : 0
                    contentHeight: dataCol.height
                    clip: true
                    interactive: false
                    Column {
                        id: dataCol
                        width: dataFlick.width
                        spacing: 2 + ed.rgap()
                        Item { width: 1; height: 2 * ed.px }
                        Text { text: "GARAGE STATE"; color: Theme.withAlpha(ed.sysColor(), 0.92)
                            font.family: ed.sysFont("headerFont"); font.bold: true; font.pixelSize: ed.hsz(11); font.letterSpacing: 4 }
                        // state readouts, each on a recessed slot (matches the dials zebra)
                        Repeater {
                            model: [
                                ["MODE",   ed.view ? ed.view.garageMode.toUpperCase() : "-", ed.sysColor()],
                                ["CHROME", ed.view ? String(ed.view.mech.chrome).toUpperCase() : "-", ed.sysInk("white")],
                                ["FONT",   ed.view ? String(ed.view.mech.font).toUpperCase() : "-", ed.sysInk("white")],
                                ["PART",   ed.focusGroup, ed.sysInk("white")],
                                ["STATUS", ed.dirty ? "UNSAVED" : "SAVED", ed.dirty ? "#ff5a5a" : "#8fe3a1"]
                            ]
                            Item {
                                required property var modelData
                                required property int index
                                width: dataCol.width; height: 17 * ed.px
                                Rectangle {
                                    anchors.fill: parent; anchors.topMargin: 1; anchors.bottomMargin: 1; radius: 2
                                    color: (index % 2 === 0) ? Theme.withAlpha("#0d0b16", 0.32) : Theme.withAlpha("#0d0b16", 0.14)
                                    border.width: 1; border.color: Theme.withAlpha(ed.sysColor(), 0.07)
                                }
                                Text { x: 5 * ed.px; anchors.verticalCenter: parent.verticalCenter
                                    text: modelData[0]; color: Theme.withAlpha(ed.sysInk(ed.sys ? ed.sys.labelInk : "light"), 0.82)
                                    font.family: ed.sysFont("editorFont"); font.pixelSize: ed.dsz(11); font.letterSpacing: 2 }
                                Text { anchors.right: parent.right; anchors.rightMargin: 5 * ed.px; anchors.verticalCenter: parent.verticalCenter
                                    text: modelData[1]; color: modelData[2]
                                    font.family: ed.sysFont("editorFont"); font.bold: true; font.pixelSize: ed.dsz(11); font.letterSpacing: 1 }
                            }
                        }
                        Item { width: 1; height: 3 * ed.px }
                        Text { text: "CONTROLS"; color: Theme.withAlpha(ed.sysColor(), 0.92)
                            font.family: ed.sysFont("headerFont"); font.bold: true; font.pixelSize: ed.hsz(11); font.letterSpacing: 4 }
                        MechKeyLegend {  // the full control set as keycap chips
                            width: dataCol.width
                            ed: ed
                            legend: [["tab","mode"],["i/v/n","c/s/n"],["-/=","page"],["j/k","dial"],
                                     ["h/l","value"],[",/.","size"],["z","undo"],["⇧z","redo"],["c","a/b"],["x","rnd"],
                                     ["g","grid"],["o","fade"],["p","dock"],["1-3","preset"],["\\","save"],["`","close"]]
                        }
                    }
                }

                Item { width: 1; height: 3 * ed.px }
                Item {  // save / undo feedback — on its own recessed plate (undo/redo/save all ride this)
                    visible: ed.view && ed.view.iconFlash.length > 0
                    width: parent.width
                    height: visible ? 15 * ed.px : 0
                    Rectangle {
                        anchors.centerIn: fbText
                        width: fbText.implicitWidth + 12 * ed.px
                        height: fbText.implicitHeight + 5 * ed.px
                        color: Theme.withAlpha("#0d0b16", 0.9)
                        border.width: 1; border.color: Theme.withAlpha("#8fe3a1", 0.42)
                        radius: 2
                    }
                    Text {
                        id: fbText
                        anchors.centerIn: parent
                        text: ed.view ? ed.view.iconFlash : ""
                        color: "#8fe3a1"
                        font.family: Theme.monoFont
                        font.bold: true
                        font.pixelSize: ed.fp(11)
                        font.letterSpacing: 2
                    }
                }
                Item {  // keytip legend — keycap chips on a dark backing, flowing
                    // to fit the panel; the key in a lit cap, the action beside it
                    visible: ed.page === "dials"
                    width: parent.width
                    height: visible ? legendFlow.height + 8 * ed.px : 0
                    Rectangle {
                        anchors.fill: parent
                        anchors.topMargin: 2 * ed.px
                        color: Theme.withAlpha("#0d0b16", 0.82)
                        border.width: 1
                        border.color: Theme.withAlpha("#aecbd9", 0.22)
                        radius: 2
                    }
                    Flow {
                        id: legendFlow
                        anchors.centerIn: parent
                        width: parent.width - 8 * ed.px
                        spacing: ed.fp(6)
                        Repeater {
                            model: [["j/k", "row"], ["h/l", "set"], ["tab", "page"], ["z", "undo"], ["c", "a/b"],
                                    ["x", "rnd"], ["g", "grid"], ["o", "fade"], ["p", "dock"], ["spc", "hide"], ["1-3", "preset"],
                                    ["i/v/n", "mode"], ["r", "reset"], ["\\", "save"], ["`", "close"]]
                            Row {
                                required property var modelData
                                spacing: ed.fp(3)
                                Rectangle {  // keycap
                                    anchors.verticalCenter: parent.verticalCenter
                                    width: kk.implicitWidth + ed.fp(6); height: kk.implicitHeight + ed.fp(3)
                                    radius: 2
                                    readonly property bool caps: !ed.sys || ed.sys.keytipCaps
                                    color: caps ? Theme.withAlpha(ed.sysColor(), 0.14) : "transparent"
                                    border.width: 1; border.color: caps ? Theme.withAlpha(ed.sysColor(), 0.42) : "transparent"
                                    Text {
                                        id: kk
                                        anchors.centerIn: parent
                                        text: modelData[0]
                                        color: ed.sysInk(ed.sys ? ed.sys.keyInk : "green")
                                        font.family: ed.sysFont("keytipFont"); font.bold: true
                                        font.pixelSize: ed.ksz(9); font.letterSpacing: 1
                                    }
                                }
                                Text {
                                    anchors.verticalCenter: parent.verticalCenter
                                    text: modelData[1]
                                    color: Theme.withAlpha("#dce8ef", 0.7)
                                    font.family: ed.sysFont("keytipFont"); font.pixelSize: ed.ksz(9); font.letterSpacing: 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
