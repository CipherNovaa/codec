        let start = row
        while (start > 0 && rows[start].h === undefined) start--
        const b = Object.assign({}, view.mech)
        for (let i = start + 1; i < rows.length && rows[i].h === undefined; ++i) {
            const r = rows[i]
            if (r.k && r.k !== chromeKey && r.opts)
                b[r.k] = r.opts[Math.floor(Math.random() * r.opts.length)]
        }
        view.mech = b
    }
    // c: bounce between the live state and the last-saved one — instant A/B
    property string abStash: ""
    function abCompare() {
        if (abStash.length > 0) {
            view.mech = JSON.parse(abStash)
            abStash = ""
        } else {
            abStash = JSON.stringify(view.mech)
            view.mech = JSON.parse(view.mechSavedJson)
        }
    }
    // o: step the panel's opacity so it never blocks the thing being tuned
    property bool leftSide: false
    // hide the panel (space) while the lock overlay stays up — it slides off the
    // docked edge; reopening the garage always brings it back
    property bool hidden: false
    // This is a persistent Item (not a Loader), so hist/redoStack/abStash
    // outlive a close. Clearing them on close stops a reopened garage from
    // resurrecting a discarded, never-saved state via undo or the A/B compare.
    onOpenChanged: {
        if (open) { hidden = false }
        else { hist = []; redoStack = []; abStash = "" }
    }
    property real panelAlpha: 1
    function cycleOpacity() {
        panelAlpha = panelAlpha > 0.9 ? 0.65 : panelAlpha > 0.5 ? 0.3 : 1
    }
    // enter: context action — dials advance the value, the bay logs the
    // asset's qrc path for wiring later
    function activate() {
        if (page === "assets") { bayZoom = !bayZoom; return }   // Enter = enlarge / shrink the preview
        if (page === "dials") {
            if (rows[row] && rows[row].c === "sfx") { Sfx.demo(); return }   // ⏎ hears the pack again (changes nothing)
            cycle(1)
        }
    }
    function savePreset(n) {
        App.putSetting(presetPrefix + n, JSON.stringify(view.mech))
        presetStamp++
        view.iconFlash = "✓ PRESET " + n + " SAVED"
        iconFlashKick.restart()
    }
    function loadPreset(n) {
        try {
            const p = App.getSetting(presetPrefix + n, "")
            if (p) {
                pushHist(false)
                view.mech = Object.assign({}, view.mechDefaults, JSON.parse(p))
            }
        } catch (e) { console.log("[mechEdit] preset load failed: " + e) }
    }
    function hasPreset(n) {
        presetStamp
        return App.getSetting(presetPrefix + n, "").length > 0
    }
    property int presetStamp: 0
    Timer { id: iconFlashKick; interval: 1500; onTriggered: ed.view.iconFlash = "" }
    function fmt(v) {
        if (v === true) return "ON"
        if (v === false) return "OFF"
        if (v === 0) return "AUTO"   // chipPx 0 = follow the display
        return String(v).toUpperCase()
    }
    readonly property int selIdx: (rows[row].k || rows[row].c) ? row : 1
    // GARAGE focus reads these: the part-group of the focused dial (walk back
    // to the nearest header), and the element key under focus in ASSEMBLY.
    readonly property string focusGroup: {
        let r = Math.min(row, rows.length - 1)
        while (r > 0 && rows[r].h === undefined) r--
        return rows[r].h || "MASTER"
    }
    readonly property string moveKey: (page === "move" && moveElems[moveIdx]) ? moveElems[moveIdx].k : ""
    readonly property string moveLabel: (page === "move" && moveElems[moveIdx]) ? moveElems[moveIdx].label : ""
    // the key of the focused dial — lets the target lock frame the SPECIFIC
    // element (the OPEN button, the LAMP…) rather than its whole parent card.
    readonly property string focusKey: (page === "dials" && rows[row] && rows[row].k) ? rows[row].k : ""
    // The focused dial's data, surfaced so the target lock can show a live
    // slider/option readout attached to it (AC5 scan-info style) — you edit in
    // COMBAT where the panel is dimmed, so the lock carries the readout.
    readonly property var focusRow: (page === "dials" && rows[row]) ? rows[row] : null
    readonly property string focusDialLabel: focusRow ? (focusRow.label || "") : ""
    readonly property var focusDialOpts: focusRow ? (focusRow.c === "sprite" && view ? view.spriteOpts() : (focusRow.opts || [])) : []
    readonly property var focusDialCur: !(focusRow && view) ? undefined
                                       : focusRow.c === "sfx" ? Sfx.pack
                                       : focusRow.c === "sfxLevel" ? Sfx.level
                                       : focusRow.k ? view.mech[focusRow.k] : undefined
    readonly property bool focusIsInk: focusRow ? (focusRow.ink === true) : false
    // keep the focused dial in view as j/k walk past the fold
    onRowChanged: {
        const it = rowsRep.itemAt(row)
        if (!it) return
        if (it.y < rowsFlick.contentY + 12)
            rowsFlick.contentY = Math.max(0, it.y - 12)
        else if (it.y + it.height > rowsFlick.contentY + rowsFlick.height - 12)
            rowsFlick.contentY = Math.min(rowsFlick.contentHeight - rowsFlick.height,
                                          it.y + it.height - rowsFlick.height + 12)
    }
    onSysIdxChanged: {
        const it = sysRep.itemAt(sysIdx)
        if (!it) return
        if (it.y < sysFlick.contentY + 12)
            sysFlick.contentY = Math.max(0, it.y - 12)
        else if (it.y + it.height > sysFlick.contentY + sysFlick.height - 12)
            sysFlick.contentY = Math.min(sysFlick.contentHeight - sysFlick.height,
                                         it.y + it.height - sysFlick.height + 12)
    }
    // keep the aimed ASSEMBLY seat in view as j/k walk past the fold (the seat
    // list is longer than the panel — mirrors the DIALS/SYSTEM scroll above)
    onMoveIdxChanged: {
        const it = moveRep.itemAt(moveIdx)
        if (!it) return
        if (it.y < moveFlick.contentY + 12)
            moveFlick.contentY = Math.max(0, it.y - 12)
        else if (it.y + it.height > moveFlick.contentY + moveFlick.height - 12)
            moveFlick.contentY = Math.min(moveFlick.contentHeight - moveFlick.height,
                                          it.y + it.height - moveFlick.height + 12)
    }

    width: 176 * px
    height: shell.height
    visible: opacity > 0.01
    readonly property string hideAnim: sys ? sys.hideAnim : "slide"
    opacity: open ? ((hidden && (hideAnim === "fade" || hideAnim === "scale")) ? 0 : panelAlpha) : 0
    Behavior on opacity { NumberAnimation { duration: 240 } }
    transform: [
        Translate {
            x: (1 - Math.min(1, ed.opacity * 3)) * 24
               + ((ed.hidden && ed.hideAnim === "slide") ? (ed.leftSide ? -(ed.width + 60) : (ed.width + 60)) : 0)
            y: (ed.hidden && ed.hideAnim === "drop") ? (ed.height + 60) : 0
            Behavior on x { NumberAnimation { duration: 280; easing.type: Easing.InOutCubic } }
            Behavior on y { NumberAnimation { duration: 280; easing.type: Easing.InOutCubic } }
        },
        Scale {
            origin.x: ed.width / 2; origin.y: ed.height / 2
            xScale: (ed.hidden && ed.hideAnim === "scale") ? 0.6 : 1
            yScale: (ed.hidden && ed.hideAnim === "scale") ? 0.6 : 1
            Behavior on xScale { NumberAnimation { duration: 280; easing.type: Easing.InOutCubic } }
            Behavior on yScale { NumberAnimation { duration: 280; easing.type: Easing.InOutCubic } }
        }
    ]

    Column {
        id: shell
        width: parent.width

        Item {
            width: parent.width
            // 7·px head + col + enough foot to clear the plate's bottom rail
            height: col.height + 20 * ed.px
            MechPanel {
                kind: "body"
                px: ed.px
                anchors.fill: parent
            }
            Column {
                id: col
                x: 8 * ed.px
                y: 7 * ed.px
                width: parent.width - 16 * ed.px
                spacing: 1

                Item {  // title header — a dark console crown: the page name in
                    // WHITE, dead-centred; the unsaved CRITICAL lamp flashes just
                    // left of it; the live PART sits dim on the right.
                    width: parent.width
                    height: 26 * ed.px
                    Rectangle {
                        id: titlePlate
                        anchors.fill: parent
                        anchors.bottomMargin: 3 * ed.px
                        visible: !ed.sys || ed.sys.titleBack !== "none"
                        color: (ed.sys && ed.sys.titleBack === "plate") ? "#1b2733" : "#141019"
                        border.width: Math.max(1, ed.px - 1)
                        border.color: Theme.withAlpha(ed.sysColor(), 0.4)
                    }
                    Rectangle {  // a hair of top light — the machined bezel
                        anchors.left: titlePlate.left; anchors.right: titlePlate.right
                        anchors.top: titlePlate.top; anchors.topMargin: Math.max(1, ed.px - 1)
                        height: Math.max(1, ed.px - 1)
                        color: Theme.withAlpha("#aecbd9", 0.12)
                    }
                    Text {
                        id: titleText
                        anchors.centerIn: titlePlate
                        text: ed.cse(ed.page === "assets" ? "ASSET VIEWER"
                            : ed.page === "move" ? "ASSEMBLY"
                            : ed.page === "system" ? "SYSTEM"
                            : ed.page === "data" ? "DATA" : "GARAGE", ed.sys ? ed.sys.titleCase : "upper")
                        color: (ed.sys && ed.sys.titleBack === "none") ? ed.sysInk("navy") : ed.sysInk(ed.sys ? ed.sys.titleInk : "white")
                        font.family: ed.sysFont("titleFont")
                        font.weight: ed.wgt(ed.sys ? ed.sys.titleWeight : "bold")
                        font.pixelSize: ed.tsz()
                        font.letterSpacing: ed.trk(ed.sys ? ed.sys.titleTrack : "wide")
                    }
                    // unsaved = CRITICAL: the pack's animated red pulse, seated to
                    // the LEFT of the centred title — flashing only when dirty.
                    MechSprite {
                        id: dirtyLamp
                        anchors.right: titleText.left
                        anchors.rightMargin: 8 * ed.px
                        anchors.verticalCenter: titleText.verticalCenter
                        visible: ed.dirty && (!ed.sys || ed.sys.lampOn)
                        source: "qrc:/assets/mechui/bar4.png"
                        fw: 16; fh: 16; frames: 6; fps: 8
                        px: Math.max(1, ed.px - 1)
                        playing: ed.dirty
                        loop: true
                    }
                    Row {  // read-only LOCK, or the live PART being tuned
                        anchors.right: titlePlate.right
                        anchors.rightMargin: 9 * ed.px
                        anchors.verticalCenter: titleText.verticalCenter
                        visible: (ed.page === "dials" || ed.page === "move") && (ed.readOnly || ed.manualEdit || !ed.sys || ed.sys.partOn)
                        spacing: ed.fp(4)
                        Item {  // amber padlock glyph when read-only
                            visible: ed.readOnly
                            anchors.verticalCenter: parent.verticalCenter
                            width: ed.fp(8); height: ed.fp(10)
                            Rectangle { anchors.top: parent.top; anchors.horizontalCenter: parent.horizontalCenter
                                width: ed.fp(5); height: ed.fp(5); radius: width / 2
                                color: "transparent"; border.width: Math.max(1, ed.px - 1); border.color: "#ffb347" }
                            Rectangle { anchors.bottom: parent.bottom; anchors.horizontalCenter: parent.horizontalCenter
                                width: ed.fp(8); height: ed.fp(6); radius: 1; color: "#ffb347" }
                        }
                        Column {
                            anchors.verticalCenter: parent.verticalCenter
                            spacing: 0
                            Text {  // just the targeted part — the padlock alone marks read-only
                                anchors.right: parent.right
                                text: ed.page === "move" ? ed.moveLabel : ed.focusGroup
                                color: ed.readOnly ? "#ffb347" : Theme.withAlpha("#aecbd9", 0.65)
                                font.family: Theme.monoFont; font.bold: true
                                font.pixelSize: ed.fp(9); font.letterSpacing: 2
                                elide: Text.ElideRight
                            }
                        }
                    }
                }

                // ── PAGE 1: the dials, scrollable ────────────────────────
                Flickable {
                    id: rowsFlick
                    visible: ed.page === "dials"
                    width: parent.width
                    height: visible ? Math.min(rowsCol.height, ed.view ? Math.round(ed.view.height * 0.6) : 430) : 0
                    contentHeight: rowsCol.height
                    clip: true
                    interactive: false
                    Behavior on contentY { NumberAnimation { duration: 120; easing.type: Easing.OutQuad } }
                    Column {
                        id: rowsCol
                        width: rowsFlick.width
                        spacing: 1 + ed.rgap()
                        Repeater {
                            id: rowsRep
                            model: ed.rows
                            Item {
                                id: line
                                required property var modelData
                                required property int index
                                readonly property bool header: modelData.h !== undefined
                                readonly property bool sel: ed.row === index
                                readonly property var val: header || !ed.view ? ""
                                    : modelData.c === "sec" ? ed.iconSec
                                    : modelData.c === "head" ? ed.view.topIcon(ed.iconSec).n
                                    : modelData.c === "foot" ? ed.view.botIcon(ed.iconSec).n
                                    : modelData.c === "sfx" ? Sfx.pack
                                    : modelData.c === "sfxLevel" ? Sfx.level + "%"
                                    : ed.view.mech[modelData.k]
                                // classic mode: everything but MASTER stands down
                                readonly property bool dimmed: ed.classic && !header && modelData.k !== "chrome"
                                // changed-since-save? touch mech + savedSnap so it re-evaluates on either
                                readonly property bool changed: {
                                    if (header || !ed.view) return false
                                    var m = ed.view.mech, s = ed.savedSnap, k = modelData.k
                                    return !!k && s[k] !== undefined && m[k] !== s[k]
                                }
                                // LOCKED: read-only inspect, OR manual-aim firing on any dial but the
                                // one you're aimed at — only the aimed dial is live, the rest padlock
                                readonly property bool locked: !header && (ed.readOnly || (ed.manualEdit && !line.sel))
                                width: rowsCol.width
                                height: header ? 14 * ed.px : (line.sel ? 18 * ed.px : 15 * ed.px)
                                Behavior on height { NumberAnimation { duration: 90; easing.type: Easing.OutQuad } }
                                // read-only / non-aimed dials grey down; the live one stays bright
                                opacity: dimmed ? 0.35 : (line.locked ? 0.5 : 1)

                                Rectangle {  // per-row slot so text isn't on a flat panel —
                                    // a faint recessed zebra that never fights the lit selector
                                    visible: !line.header && !line.sel
                                    anchors.fill: parent; anchors.topMargin: 1; anchors.bottomMargin: 1
                                    radius: 2
                                    color: (line.index % 2 === 0) ? Theme.withAlpha("#0d0b16", 0.32) : Theme.withAlpha("#0d0b16", 0.14)
                                    border.width: 1
                                    border.color: Theme.withAlpha(ed.sysColor(), 0.07)
                                }
                                Rectangle {  // red "changed since save" pip in the left gutter
                                    visible: line.changed
                                    z: 5
                                    anchors.left: parent.left; anchors.leftMargin: -ed.px
                                    anchors.verticalCenter: parent.verticalCenter
                                    width: Math.max(2, Math.round(2.5 * ed.px)); height: parent.height - Math.round(7 * ed.px)
                                    radius: width / 2; color: "#ff5a5a"
                                }

                                Text {  // group header = the PART heading
                                    visible: line.header
                                    anchors.bottom: parent.bottom
                                    anchors.bottomMargin: 2
                                    text: line.header ? line.modelData.h : ""
                                    color: Theme.withAlpha(ed.sysInk(ed.sys ? ed.sys.headerInk : "trim"), 0.92)
                                    font.family: ed.sysFont("headerFont")
                                    font.bold: true
                                    font.pixelSize: ed.hsz(11)
                                    font.letterSpacing: 4
                                }
                                MechButton {  // the focused row rides a real button —
                                    // bleeds a hair past the row so the selection
                                    // frame reads as a clear lit plate, not a stripe
                                    visible: line.sel && !line.header
                                    anchors.fill: parent
                                    anchors.leftMargin: -2 * ed.px
                                    anchors.rightMargin: -2 * ed.px
                                    family: 3
                                    px: ed.px
                                    hot: true
                                }
                                Text {
                                    visible: !line.header
                                    x: (line.sel ? 6 : 4) * ed.px
                                    anchors.verticalCenter: parent.verticalCenter
                                    text: line.header ? "" : line.modelData.label
                                    color: line.sel ? "#14121f" : Theme.withAlpha(ed.sysInk(ed.sys ? ed.sys.labelInk : "light"), 0.94)
                                    font.family: ed.sysFont("editorFont")
                                    font.bold: line.sel
                                    font.pixelSize: line.sel ? ed.dsz(13) : ed.dsz(12)
                                    font.letterSpacing: 1
                                }
                                Row {
                                    visible: !line.header
                                    anchors.right: parent.right
                                    anchors.rightMargin: 4 * ed.px
                                    anchors.verticalCenter: parent.verticalCenter
                                    spacing: 5
                                    Item {  // padlock — read-only inspect, or every dial but the aimed one while firing
                                        visible: line.locked
                                        anchors.verticalCenter: parent.verticalCenter
                                        width: ed.fp(6); height: ed.fp(9)
                                        Rectangle {  // shackle
                                            anchors.top: parent.top; anchors.horizontalCenter: parent.horizontalCenter
                                            width: ed.fp(5); height: ed.fp(5); radius: ed.fp(2.5)
                                            color: "transparent"; border.width: 1; border.color: Theme.withAlpha("#f0a54e", 0.85)
                                        }
                                        Rectangle {  // body
                                            anchors.bottom: parent.bottom; anchors.horizontalCenter: parent.horizontalCenter
                                            width: ed.fp(6); height: ed.fp(5); radius: 1
                                            color: Theme.withAlpha("#f0a54e", 0.85)
                                            Rectangle {  // keyhole — reads as a real lock, not a plate
                                                anchors.centerIn: parent
                                                width: Math.max(1, ed.fp(1.5)); height: width; radius: width / 2
                                                color: "#1a1420"
                                            }
                                        }
                                    }
                                    Rectangle {  // ink swatch
                                        visible: line.modelData.ink === true && line.val !== "auto"
                                        anchors.verticalCenter: parent.verticalCenter
                                        width: 4 * ed.px; height: 4 * ed.px
                                        color: ed.view ? ed.view.mechInk(line.val) : "#fff"
                                        border.width: 1
                                        border.color: "#222034"
                                    }
                                    Text {  // font specimen, in the font
                                        // itself ("inherit" shows the base)
                                        visible: line.modelData.specimen === true
                                        anchors.verticalCenter: parent.verticalCenter
                                        text: "Aa9"
                                        color: line.sel ? "#222034" : "#e6eff5"
                                        font.family: !ed.view ? Theme.monoFont
                                            : ed.view.mechFontFor(line.val === "inherit" ? ed.view.mech.font : line.val)
                                        font.pixelSize: ed.fp(11)
                                    }
                                    Text {
                                        anchors.verticalCenter: parent.verticalCenter
                                        text: line.header ? "" : ed.fmt(line.val)
                                        color: line.sel ? "#222034" : ed.sysInk(ed.sys ? ed.sys.valueInk : "white")
                                        font.family: ed.sysFont("editorFont")
                                        font.bold: true
                                        font.pixelSize: ed.dsz(12)
                                        font.letterSpacing: 1
                                    }
                                }
                            }
                        }
                    }
                }

                Item {  // option strip: every choice on the focused dial,
                    // the live one boxed — a segmented control's readout
                    visible: ed.page === "dials" && (!ed.sys || ed.sys.stripOn)
                    width: parent.width
                    height: visible ? 17 * ed.px : 0
                    opacity: ed.readOnly ? 0.5 : 1   // dimmed when you can't edit
                    Rectangle {   // recessed plate — one family with the presets + feedback + legend
                        anchors.fill: parent
                        anchors.topMargin: 2
                        anchors.bottomMargin: 2
                        color: Theme.withAlpha("#0d0b16", 0.82)
                        border.width: 1; border.color: Theme.withAlpha("#aecbd9", 0.22)
                        radius: 2
                    }
                    Text {
                        anchors.centerIn: parent
                        width: parent.width - 8
                        horizontalAlignment: Text.AlignHCenter
                        textFormat: Text.StyledText
                        text: {
                            const r = ed.rows[ed.selIdx]
                            if (!r || !ed.view) return ""
                            if (r.c === "sec")
                                return ed.secList.map(s => s === ed.iconSec
                                    ? "<font color='#8fe3a1'><b>[" + s.toUpperCase() + "]</b></font>"
                                    : s.toUpperCase()).join(" ")
                            if (r.c === "head" || r.c === "foot") {
                                const sel = r.c === "head" ? ed.view.topSel : ed.view.botSel
                                const pool = ed.view.iconPoolFor(ed.iconSec)
                                return "ICON " + ((sel[ed.iconSec] || 0) + 1) + " / " + pool.length
                            }
                            if (r.c === "sprite") {
                                const scur = ed.view.mech[r.k]
                                return ed.view.spriteOpts().map(o => o === scur
                                    ? "<font color='#8fe3a1'><b>[" + ed.fmt(o) + "]</b></font>"
                                    : ed.fmt(o)).join(" ")
                            }
                            if (r.c === "sfx" || r.c === "sfxLevel") {
                                const sc = r.c === "sfx" ? Sfx.pack : Sfx.level
                                return r.opts.map(o => o === sc
                                    ? "<font color='#8fe3a1'><b>[" + ed.fmt(o) + "]</b></font>"
                                    : ed.fmt(o)).join(" ")
                            }
                            if (!r.k) return ""
                            const cur = ed.view.mech[r.k]
                            return r.opts.map(o => o === cur
                                ? "<font color='#8fe3a1'><b>[" + ed.fmt(o) + "]</b></font>"
                                : ed.fmt(o)).join(" ")
                        }
                        color: Theme.withAlpha("#cfe0ea", 0.95)
                        elide: Text.ElideRight
                        font.family: ed.view ? ed.view.mechFontFor("mgshud") : Theme.monoFont
                        font.pixelSize: ed.fp(16)   // bigger — fills the option-strip box
                        font.letterSpacing: 1
                    }
                }

                Item {  // one-line explainer for the focused dial — what it does,
                    // in plain words, for the options whose label isn't obvious
                    visible: ed.page === "dials" && (!ed.sys || ed.sys.descOn) && !!(ed.focusRow && ed.focusRow.desc)
                    width: parent.width
                    height: visible ? 12 * ed.px : 0
                    Text {
                        anchors.centerIn: parent
                        width: parent.width - 8
                        horizontalAlignment: Text.AlignHCenter
                        text: !(ed.focusRow && ed.focusRow.desc) ? ""
                              : ed.focusRow.c === "sfx" ? Sfx.packNote(Sfx.pack) + " · ⏎ plays it again"
                              : ed.focusRow.desc
                        color: Theme.withAlpha("#9fd8e6", 0.9)
                        elide: Text.ElideRight
                        font.family: ed.view ? ed.view.mechFontFor("mgshud") : Theme.monoFont
                        font.italic: true
                        font.pixelSize: ed.fp(10)
                        font.letterSpacing: 1
                    }
                }

                Item {  // presets: three slots, filled lamps
                    visible: ed.page === "dials"
                    width: parent.width
                    height: visible ? 14 * ed.px : 0
                    Rectangle {   // recessed plate — matches the option strip + legend
                        anchors.fill: parent; anchors.topMargin: 2; anchors.bottomMargin: 2
                        color: Theme.withAlpha("#0d0b16", 0.82)
                        border.width: 1; border.color: Theme.withAlpha("#aecbd9", 0.22)
                        radius: 2
                    }
                    Row {
                        anchors.centerIn: parent
                        spacing: 8
                        Text {
                            anchors.verticalCenter: parent.verticalCenter
                            text: "PRESETS"
                            color: Theme.withAlpha("#aecbd9", 0.55)
                            font.family: Theme.monoFont
                            font.pixelSize: ed.fp(8)
                            font.letterSpacing: 2
                        }
                        Repeater {
                            model: 3
                            Item {
                                required property int index
                                width: 12 * ed.px; height: 8 * ed.px
                                Rectangle {
                                    anchors.fill: parent
                                    color: "#222034"
                                    border.width: 1
                                    border.color: Theme.withAlpha("#aecbd9", 0.4)
                                }
                                Text {
                                    anchors.centerIn: parent
                                    text: (index + 1)
                                    color: ed.hasPreset(index + 1) ? "#8fe3a1" : Theme.withAlpha("#dce8ef", 0.4)
                                    font.family: Theme.monoFont
                                    font.bold: true
                                    font.pixelSize: ed.fp(11)
                                }
                            }
                        }
                    }
                }

                // ── PAGE 2: MOVE mode — hand-trim element seats. Scrolls inside
                //    the fixed frame (the seat list outgrew the panel); j/k keeps
                //    the aimed row in view (see onMoveIdxChanged).
                Flickable {
                    id: moveFlick
                    visible: ed.page === "move"
                    width: parent.width
                    height: visible ? Math.min(moveCol.height, ed.view ? Math.round(ed.view.height * 0.6) : 430) : 0
                    contentHeight: moveCol.height
                    clip: true
                    interactive: false
                    Behavior on contentY { NumberAnimation { duration: 120; easing.type: Easing.OutQuad } }
                    Column {
                        id: moveCol
                        width: moveFlick.width
                        spacing: 1
                        Repeater {
                            id: moveRep
                            model: ed.moveElems
                        Item {
                            id: mline
                            required property var modelData
                            required property int index
                            readonly property bool sel: ed.moveIdx === index
                            // RAW reference-px offset (not mOff, which is ×offScale for render): the
                            // readout + the changed-pip must match the SAVED snapshot, which stores
                            // reference px — else every non-zero row reads dirty on any resolution
                            // where s != sRef (scaled != saved) and no save can ever clear it.
                            readonly property var off: ed.view ? ed.view.mOffRaw(modelData.k) : [0, 0]
                            readonly property real scl: (ed.view && ed.view.mScale) ? ed.view.mScale(modelData.k) : 1
                            // read-only protection (mirrors the DIALS page): all rows padlock in
                            // read-only; in manual aim (Ctrl) only the AIMED row stays live
                            readonly property bool locked: ed.readOnly || (ed.manualEdit && !mline.sel)
                            // changed-since-save (mirrors the DIALS red pip): offset OR scale differs from the saved snapshot
                            readonly property bool changed: {
                                if (!ed.view) return false
                                var k = modelData.k
                                var so = ed.savedSnap.offsets || {}, ss = ed.savedSnap.scales || {}
                                var oc = ed.view.mOffRaw(k), os = so[k] || [0, 0]   // raw ref-px vs saved ref-px
                                var sv = (ss[k] === undefined || ss[k] === null) ? 1 : ss[k]
                                return oc[0] !== os[0] || oc[1] !== os[1] || Math.abs(mline.scl - sv) > 0.001
                            }
                            width: col.width
                            height: 12 * ed.px
                            Rectangle {  // recessed zebra slot — matches the DIALS page
                                visible: !mline.sel
                                anchors.fill: parent; anchors.topMargin: 1; anchors.bottomMargin: 1
                                radius: 2
                                color: (mline.index % 2 === 0) ? Theme.withAlpha("#0d0b16", 0.32) : Theme.withAlpha("#0d0b16", 0.14)
                                border.width: 1
                                border.color: Theme.withAlpha(ed.sysColor(), 0.07)
                            }
                            MechButton {
                                visible: mline.sel
                                anchors.fill: parent
                                family: 3
                                px: ed.px
                                hot: true
                            }
                            Rectangle {  // red "changed since save" pip — same gutter marker as the DIALS page
                                visible: mline.changed
                                z: 5
                                anchors.left: parent.left; anchors.leftMargin: -ed.px
                                anchors.verticalCenter: parent.verticalCenter
                                width: Math.max(2, Math.round(2.5 * ed.px)); height: parent.height - Math.round(5 * ed.px)
                                radius: width / 2; color: "#ff5a5a"
                            }
                            Text {
                                x: 4 * ed.px
                                anchors.verticalCenter: parent.verticalCenter
                                text: mline.modelData.label
                                color: mline.sel ? "#222034" : Theme.withAlpha("#dce8ef", 0.78)
                                font.family: Theme.monoFont
                                font.bold: mline.sel
                                font.pixelSize: ed.fp(10)
                                font.letterSpacing: 1
                                opacity: mline.locked ? 0.5 : 1
                            }
                            Item {  // padlock — read-only inspect, or every element but the aimed one while firing
                                visible: mline.locked
                                anchors.right: parent.right; anchors.rightMargin: 4 * ed.px
                                anchors.verticalCenter: parent.verticalCenter
                                width: ed.fp(6); height: ed.fp(9)
                                Rectangle { anchors.top: parent.top; anchors.horizontalCenter: parent.horizontalCenter
                                    width: ed.fp(5); height: ed.fp(5); radius: ed.fp(2.5)
                                    color: "transparent"; border.width: 1; border.color: Theme.withAlpha("#f0a54e", 0.85) }
                                Rectangle { anchors.bottom: parent.bottom; anchors.horizontalCenter: parent.horizontalCenter
                                    width: ed.fp(6); height: ed.fp(5); radius: 1; color: Theme.withAlpha("#f0a54e", 0.85)
                                    Rectangle { anchors.centerIn: parent; width: Math.max(1, ed.fp(1.5)); height: width; radius: width / 2; color: "#1a1420" } }
                            }
                            Text {
                                anchors.right: parent.right
                                anchors.rightMargin: 4 * ed.px + (mline.locked ? ed.fp(11) : 0)   // clear the padlock
                                anchors.verticalCenter: parent.verticalCenter
                                text: (mline.off[0] >= 0 ? "+" : "") + mline.off[0]
                                      + " , " + (mline.off[1] >= 0 ? "+" : "") + mline.off[1]
                                      + (mline.modelData.size ? "  ×" + mline.scl.toFixed(2) : "")
                                color: mline.sel ? "#222034"
                                     : (mline.off[0] !== 0 || mline.off[1] !== 0 || Math.abs(mline.scl - 1) > 0.001) ? "#8fe3a1" : "#e6eff5"
                                font.family: Theme.monoFont
                                font.bold: true
                                font.pixelSize: ed.fp(10)
                                opacity: mline.locked ? 0.5 : 1
                            }
                        }
                    }
                    Item { width: 1; height: 3 * ed.px }
                    MechKeyLegend {  // keycap chips — same treatment as the DIALS/GARAGE legend
                        width: parent.width
                        ed: ed
                        legend: [["j/k","pick"],["h/l","move"],["[ ]","y"],[", .","size"],["⇧","×5"],["z","undo"],["⇧z","redo"],["r","reset"]]
                    }
                    }
                }

                // ── PAGE 3: the ASSET VIEWER (browse + inspect + open in Aseprite) ──
                Item {
                    id: assetPage
                    visible: ed.page === "assets"
                    width: parent.width
                    height: visible ? 524 : 0
                    // ── ASSET VIEWER — browse (wall) + inspect (plays) + open in Aseprite ──
                    readonly property var a: ed.curAsset
                    readonly property bool isGif: a ? String(a.file).indexOf(".gif") >= 0 : false
                    readonly property int frames: ed.bayFrames(a)
                    readonly property int fw: a ? (frames > 1 ? Math.round(a.w / frames) : a.w) : 1
                    // wall column count derived from the panel width; kept in ed.bayCols
                    // so j/k step a whole row (nav reads it)
                    readonly property int cols: Math.max(3, Math.floor((width - 8) / 92))
                    onColsChanged: ed.bayCols = cols
                    Component.onCompleted: ed.bayCols = cols
                    Column {
                        anchors.fill: parent
                        anchors.topMargin: 4
                        spacing: 6
                        // ── source tabs (PACKS / LIBRARY) ──
                        Row {
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 8
                            Repeater {
                                model: [["PACKS", 0], ["MY SPRITES", 1]]
                                Rectangle {
                                    readonly property bool on: ed.baySource === modelData[1]
                                    width: tabT.implicitWidth + 22; height: tabT.implicitHeight + 8; radius: 2
                                    color: on ? Theme.withAlpha(ed.sysColor(), 0.9) : Theme.withAlpha("#0d0b16", 0.7)
                                    border.width: 1; border.color: Theme.withAlpha(ed.sysColor(), on ? 0.95 : 0.3)
                                    Text {
                                        id: tabT; anchors.centerIn: parent; text: modelData[0]
                                        color: on ? "#080d13" : Theme.withAlpha("#dce8ef", 0.75)
                                        font.family: Theme.monoFont; font.bold: true
                                        font.pixelSize: ed.fp(10); font.letterSpacing: 2
                                    }
                                    MouseArea { anchors.fill: parent; onClicked: if (ed.baySource !== modelData[1]) ed.baySourceStep(1) }
                                }
                            }
                        }
                        // ── inspector: big preview (plays) + name/dims + source badge ──
                        Item {
                            id: inspector
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: assetPage.width - 8
                            height: 128
                            Rectangle { anchors.fill: parent; color: "#0b0910"; border.width: 1; border.color: Theme.withAlpha(ed.sysColor(), 0.38); radius: 2 }
                            Repeater {
                                model: 4
                                Item {
                                    readonly property bool rt: index === 1 || index === 3
                                    readonly property bool bt: index >= 2
                                    x: rt ? inspector.width - 9 : 3
                                    y: bt ? inspector.height - 9 : 3
                                    width: 6; height: 6
                                    Rectangle { x: parent.rt ? 4 : 0; width: 2; height: 6; color: Theme.withAlpha(ed.sysColor(), 0.7) }
                                    Rectangle { y: parent.bt ? 4 : 0; width: 6; height: 2; color: Theme.withAlpha(ed.sysColor(), 0.7) }
                                }
                            }
                            // the preview stage (left). DEFAULT = whole asset, STATIC
                            // (a spritesheet shows its grid, a strip its filmstrip). `p`
                            // toggles ed.bayPlay → then it animates AS a horizontal strip.
                            AssetPreview {
                                id: previewBox
                                x: 8; width: 116
                                anchors.verticalCenter: parent.verticalCenter
                                height: parent.height - 16
                                ed: ed; a: assetPage.a; isGif: assetPage.isGif
                            }
                            Column {  // meta (right)
                                anchors.left: previewBox.right; anchors.leftMargin: 12
                                anchors.right: parent.right; anchors.rightMargin: 10
                                anchors.verticalCenter: parent.verticalCenter
                                spacing: 5
                                Text {
                                    width: parent.width; elide: Text.ElideMiddle
                                    text: assetPage.a ? (assetPage.a.name || "") : (ed.baySource === 1 ? "NO SPRITES YET" : "NO ASSETS")
                                    color: "#f2f8fc"; font.family: Theme.monoFont; font.bold: true
                                    font.pixelSize: ed.fp(12); font.letterSpacing: 1
                                }
                                Text {
                                    width: parent.width; elide: Text.ElideMiddle
                                    text: assetPage.a ? (assetPage.a.pack ? assetPage.a.pack.toUpperCase() : "MY SPRITES")
                                                        + "  ·  " + (ed.assetIdx + 1) + " / " + ed.bayList.length : ""
                                    color: Theme.withAlpha("#aecbd9", 0.75); font.family: Theme.monoFont
                                    font.pixelSize: ed.fp(9); font.letterSpacing: 2
                                }
                                Text {
                                    width: parent.width; elide: Text.ElideMiddle
                                    // frame count only appears while PLAYING (it's a strip guess,
                                    // meaningless for spritesheets/static) — with the ,/. adjust hint
                                    text: assetPage.a ? assetPage.a.w + "×" + assetPage.a.h
                                                        + (assetPage.isGif ? "  ·  GIF"
                                                           : ed.bayPlay ? "  ·  ▶ " + ed.bayFramesEff(assetPage.a) + "f ( , . )"
                                                           : "") : ""
                                    color: ed.bayPlay ? "#8fe3f5" : Theme.withAlpha("#dce8ef", 0.72)
                                    font.family: Theme.monoFont; font.pixelSize: ed.fp(10); font.letterSpacing: 1
                                }
                                // source badge — plain-language: built-in (copy to edit) vs yours
                                Rectangle {
                                    visible: assetPage.a !== null
                                    width: badgeT.implicitWidth + 14; height: badgeT.implicitHeight + 6; radius: 2
                                    color: Theme.withAlpha(ed.baySource === 1 ? "#5fcde4" : "#f0a54e", 0.16)
                                    border.width: 1; border.color: Theme.withAlpha(ed.baySource === 1 ? "#5fcde4" : "#f0a54e", 0.7)
                                    Text {
                                        id: badgeT; anchors.centerIn: parent
                                        text: ed.baySource === 1 ? "◆ YOURS · EDITABLE" : "▨ BUILT-IN · COPY TO EDIT"
                                        color: ed.baySource === 1 ? "#8fe3f5" : "#ffcf6b"
                                        font.family: Theme.monoFont; font.bold: true
                                        font.pixelSize: ed.fp(9); font.letterSpacing: 1
                                    }
                                }
                            }
                        }
                        // ── the thumbnail WALL ──
                        Item {
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: assetPage.width - 8
                            height: 300
                            Rectangle { anchors.fill: parent; color: Theme.withAlpha("#0b0910", 0.55); border.width: 1; border.color: Theme.withAlpha(ed.sysColor(), 0.22); radius: 2 }
                            Text {  // empty-state
                                anchors.centerIn: parent
                                visible: ed.bayList.length === 0
                                text: ed.baySource === 1 ? "NO SPRITES YET\nCOPY ONE FROM PACKS (c)" : "NO ASSETS FOUND"
                                horizontalAlignment: Text.AlignHCenter
                                color: Theme.withAlpha("#dce8ef", 0.5); font.family: Theme.monoFont
                                font.pixelSize: ed.fp(10); font.letterSpacing: 2
                            }
                            GridView {
                                id: wall
                                anchors.centerIn: parent
                                readonly property int cw: Math.floor((parent.width - 6) / assetPage.cols)
                                width: cw * assetPage.cols; height: parent.height - 6
                                clip: true; interactive: false
                                cellWidth: cw; cellHeight: cw
                                model: ed.bayList
                                currentIndex: ed.assetIdx
                                onCurrentIndexChanged: positionViewAtIndex(currentIndex, GridView.Contain)
                                delegate: Item {
                                    width: wall.cellWidth; height: wall.cellHeight
                                    readonly property bool sel: index === ed.assetIdx
                                    Rectangle {
                                        anchors.fill: parent; anchors.margins: 2; radius: 2
                                        color: sel ? Theme.withAlpha(ed.sysColor(), 0.2) : Theme.withAlpha("#0d0b16", 0.5)
                                        border.width: sel ? 2 : 1
                                        border.color: sel ? ed.sysColor() : Theme.withAlpha(ed.sysColor(), 0.18)
                                    }
                                    Image {  // fit whole asset into the cell (strips read as filmstrips)
                                        anchors.centerIn: parent
                                        width: parent.width - 10; height: parent.height - 10
                                        source: ed.assetSrc(modelData)
                                        fillMode: Image.PreserveAspectFit
                                        sourceSize.width: 128; sourceSize.height: 128
                                        smooth: false; asynchronous: true; cache: true
                                    }
                                    MouseArea { anchors.fill: parent; onClicked: ed.assetIdx = index }
                                }
                            }
                        }
                        // ── keytips ──
                        MechKeyLegend {
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: assetPage.width - 12
                            ed: ed
                            legend: [["hjkl","browse"],["ret","enlarge"],["p","play"],["s","source"],["o","aseprite"],["c","copy"]]
                        }
                    }

                    // ── BIG PREVIEW (Enter) — the whole page becomes one large asset ──
                    Item {
                        anchors.fill: parent
                        visible: ed.bayZoom && assetPage.a !== null
                        z: 20
                        Rectangle { anchors.fill: parent; color: "#080b12"; border.width: 1; border.color: Theme.withAlpha(ed.sysColor(), 0.45); radius: 2 }
                        Column {
                            anchors.fill: parent; anchors.margins: 10; spacing: 6
                            AssetPreview {
                                width: parent.width; height: parent.height - nameZ.height - metaZ.height - tipZ.height - 18
                                ed: ed; a: assetPage.a; isGif: assetPage.isGif
                            }
                            Text {
                                id: nameZ; width: parent.width; horizontalAlignment: Text.AlignHCenter; elide: Text.ElideMiddle
                                text: assetPage.a ? (assetPage.a.name || "") : ""
                                color: "#f2f8fc"; font.family: Theme.monoFont; font.bold: true
                                font.pixelSize: ed.fp(13); font.letterSpacing: 1
                            }
                            Text {
                                id: metaZ; width: parent.width; horizontalAlignment: Text.AlignHCenter; elide: Text.ElideMiddle
                                text: assetPage.a ? assetPage.a.w + "×" + assetPage.a.h
                                                    + (assetPage.isGif ? "  ·  GIF"
                                                       : ed.bayPlay ? "  ·  ▶ " + ed.bayFramesEff(assetPage.a) + "f ( , . )" : "") : ""
                                color: ed.bayPlay ? "#8fe3f5" : Theme.withAlpha("#dce8ef", 0.72)
                                font.family: Theme.monoFont; font.pixelSize: ed.fp(10); font.letterSpacing: 1
                            }
                            MechKeyLegend {
                                id: tipZ; anchors.horizontalCenter: parent.horizontalCenter
                                width: assetPage.width - 12; ed: ed
                                legend: [["ret","back"],["p","play"],["o","aseprite"],["c","copy"]]
                            }
                        }
                    }
                }

                // ── PAGE 4a: SYSTEM — the editor styles itself ────────────────
                Flickable {  // SYSTEM scrolls inside the same fixed frame as DIALS
                    id: sysFlick
                    visible: ed.page === "system"
                    width: parent.width
                    height: visible ? Math.min(sysCol.height, ed.view ? Math.round(ed.view.height * 0.6) : 430) : 0
                    contentHeight: sysCol.height
                    clip: true
                    interactive: false
                    Behavior on contentY { NumberAnimation { duration: 120; easing.type: Easing.OutQuad } }
                    Column {
                    id: sysCol
                    width: sysFlick.width
                    spacing: 1
                    Repeater {
                        id: sysRep
                        model: ed.sysRows
                        Item {
                            id: sline
                            required property var modelData
                            required property int index
                            readonly property bool header: modelData.h !== undefined
                            readonly property bool sel: ed.sysIdx === index
                            width: parent.width
                            height: header ? 14 * ed.px : (sel ? 18 * ed.px : 15 * ed.px)
                            Behavior on height { NumberAnimation { duration: 90; easing.type: Easing.OutQuad } }
                            Rectangle {  // recessed zebra slot — matches the DIALS page
                                visible: !sline.header && !sline.sel
                                anchors.fill: parent; anchors.topMargin: 1; anchors.bottomMargin: 1
                                radius: 2
                                color: (sline.index % 2 === 0) ? Theme.withAlpha("#0d0b16", 0.32) : Theme.withAlpha("#0d0b16", 0.14)
                                border.width: 1
                                border.color: Theme.withAlpha(ed.sysColor(), 0.07)
                            }
                            Text {
                                visible: sline.header
                                anchors.bottom: parent.bottom; anchors.bottomMargin: 2
                                text: sline.header ? sline.modelData.h : ""
                                color: Theme.withAlpha("#aecbd9", 0.92)
                                font.family: Theme.monoFont; font.bold: true
                                font.pixelSize: ed.fp(11); font.letterSpacing: 4
                            }
                            MechButton {
                                visible: sline.sel && !sline.header
                                anchors.fill: parent; anchors.leftMargin: -2 * ed.px; anchors.rightMargin: -2 * ed.px
                                family: 3; px: ed.px; hot: true
                            }
                            Text {
                                visible: !sline.header
                                x: (sline.sel ? 6 : 4) * ed.px
                                anchors.verticalCenter: parent.verticalCenter
                                text: sline.modelData.label || ""
                                color: sline.sel ? "#14121f" : Theme.withAlpha("#eef5fa", 0.94)
                                font.family: Theme.monoFont; font.bold: sline.sel
                                font.pixelSize: sline.sel ? ed.fp(13) : ed.fp(12); font.letterSpacing: 1
                            }
                            Row {
                                visible: !sline.header
                                anchors.right: parent.right; anchors.rightMargin: 4 * ed.px
                                anchors.verticalCenter: parent.verticalCenter
                                spacing: 5
                                Rectangle {
                                    visible: sline.modelData.ink === true
