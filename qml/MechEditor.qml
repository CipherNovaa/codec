// The mech style editor — the permanent debug rig for mecha mode, built
// FROM the pack (body plate shell, button-plate row highlight, chip title).
// M toggles it on the home screen; the view routes keys here while open.
//
// PAGE 1 · DIALS (scrollable): every element of the home screen has its
// own row, grouped MASTER / CARD / WHEEL / SPOTLIGHT / BADGES / TYPE /
// DECK. j/k rows (auto-scroll), h/l cycle the focused style ON THE LIVE
// SCREEN, 1-3 load presets, shift+1-3 save, x randomize, r reset,
// \ persist, m/esc close.
//
// PAGE 2 · ASSET BAY (Tab/b): a viewer over EVERY imported external asset
// (assets/mechext + manifest.json, generated by import_mechui.py) — j/k
// walk assets, h/l jump packs; strips whose width is a clean multiple of
// their height play as animations. Future-feature stock, browsable today.
Item {
    id: ed
    property var view          // the HomeView — mech map + mechSet live there
    property bool open: false
    property int row: 1        // row 0 is the MASTER header — start on CHROME
    property string page: "dials"
    // ── host-swappable config (defaults = HomeView; StatsView passes its own) ──
    property string presetPrefix: "mechUiPreset"   // StatsView → "statUiPreset"
    property string chromeKey: "chrome"            // the key randomize never flips ("" = none)
    // auto-fit: cap the panel at px 2 on SHORT screens (the CRT is 1024px tall) so it never
    // extends past the border, whatever the SYSTEM SCALE dial says.
    readonly property int px: {
        var base = sys ? (sys.scale === "small" ? 2 : sys.scale === "large" ? 4 : 3) : 3
        return (view && view.height > 0 && view.height < 1120 && base > 2) ? 2 : base
    }
    // editor text scales WITH the panel (px) so enlarging the garage enlarges
    // its type too — legibility, not just more empty plate
    function fp(n) { return Math.round(n * px / 2) }
    readonly property bool classic: view && view.mech.chrome === "classic"
    // values only CHANGE in combat; scan (calibrate) & normal (survey) are read-only
    readonly property bool readOnly: view ? !view.canEdit : true
    // editing live via SCAN + Ctrl manual-aim (aim & fire) — distinct from COMBAT; the
    // title tag reflects it, and the value readouts only show while editing is applicable
    readonly property bool manualEdit: !readOnly && view && view.garageMode === "scan"
    // per-dial "changed since last save" — a red pip marks each dial whose value differs
    // from the saved snapshot, so a run of manual edits leaves a visible trail (even if
    // you closed + reopened the editor). Cleared for a dial when its value is saved back.
    property var savedSnap: ({})
    function refreshSnap() { try { savedSnap = (view && view.mechSavedJson) ? JSON.parse(view.mechSavedJson) : ({}) } catch (e) { savedSnap = ({}) } }
    onViewChanged: refreshSnap()
    Connections { target: ed.view; ignoreUnknownSignals: true
        function onMechSavedJsonChanged() { ed.refreshSnap() } }
    // canonical (sorted-key) compare so cycling a value back to its saved setting
    // clears the dirty flag — a raw stringify is key-order sensitive and can latch
    // "unsaved" even when nothing net-changed (auto → colour → auto).
    function canon(o) {
        if (o === null || typeof o !== "object") return o
        if (Array.isArray(o)) return o.map(canon)
        var out = {}, ks = Object.keys(o).sort()
        for (var i = 0; i < ks.length; ++i) out[ks[i]] = canon(o[ks[i]])
        return out
    }
    readonly property bool dirty: {
        if (!view) return false
        try { return JSON.stringify(canon(view.mech)) !== JSON.stringify(canon(JSON.parse(view.mechSavedJson))) }
        catch (e) { return false }
    }

